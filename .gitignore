# Agent scratch and run logs — machine-local, never useful to another dev.
.agent-logs/
*.log
*.pid

# Python bytecode from the local-tasks fixture tooling.
__pycache__/
*.pyc

# Supabase CLI local state. Migrations and seed.sql ARE tracked; these are not.
supabase/.temp/
supabase/.branches/

# Locally-generated student/admin account rosters with plaintext passwords.
# Never commit these — they must be moved to a password vault immediately after provisioning.
bin/.roster-output/

node_modules/
_site/
